@model IEnumerable<Arhitekt.Models.User>

@{
    ViewData["Title"] = "Discover Architects";
}

<div class="container mt-5">
    <h1 class="text-center mb-4">Discover Users</h1>

    <div class="row">
        @foreach (var user in Model)
        {
            <div class="col-md-6 mb-4">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">@user.FirstName @user.LastName</h5>
                        <p class="card-text">Email: @user.Email</p>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    body {
        background-color: #1C1C1C;
        color: #ECECEC;
    }

    .card {
        background-color: #2D2D2D;
        border: none;
        border-radius: 8px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.2);
    }

    .btn-outline-primary {
        border-color: #6A936C;
        color: #6A936C;
    }

    .btn-outline-primary:hover {
        background-color: #6A936C;
        color: #ECECEC;
    }
</style>
