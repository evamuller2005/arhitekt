@{
    ViewData["Title"] = "Home Page";
}

<div class="hero bg-dark text-center py-5">
    <h1 style="color: #ECECEC; font-size: 3em; font-family: 'Cursive';">Welcome to Architect</h1>
    <p class="lead" style="color: #B0B0B0;">Discover the finest architects and their most iconic projects.</p>
</div>

<style>
    body {
        background-color: #1C1C1C; /* tmno ozadje */
        color: #ECECEC; /* barva teksta */
    }

    /* za kartice */
    .card {
        background-color: #2D2D2D; 
        border: none;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.2);
        border-radius: 8px;
    }

    /* za slikce */
    .card-img-top {
        height: 200px;
        object-fit: cover; 
        border-top-left-radius: 8px;
        border-top-right-radius: 8px;
    }

    /* gumb  */
    .btn-outline-primary {
        border-color: #6A936C; 
        color: #6A936C;
    }

    .btn-outline-primary:hover {
        background-color: #6A936C;
        color: #ECECEC;
    }
}
</style>

<br />

