@{
    ViewData["Title"] = "Home Page";
    var projects = ViewData["Projects"] as List<Arhitekt.Models.Project>;
}

<div class="hero bg-dark text-center py-5">
    <h1 style="color: #ECECEC; font-size: 3em; font-family: 'Cursive';">Welcome to Architect</h1>
    <p class="lead" style="color: #B0B0B0;">Find inspiration and connect with exceptional architects.</p>
</div>

<div class="container mt-5">
    <div class="row">
        @if (projects != null && projects.Any())
        {
            foreach (var project in projects)
            {
                <div class="col-md-4 mb-4">
                    <div class="card">
                        <img src="@project.Image" class="card-img-top" alt="@project.Name" />
                        <div class="card-body">
                            <h5 class="card-title">@project.Name</h5>
                            <p class="card-text">@project.Description</p>
                            <a href="/Project/Details/@project.ProjectID" class="btn btn-outline-primary">View Project</a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <p class="text-center" style="color: #ECECEC;">No projects available at the moment.</p>
        }
    </div>
</div>

<style>
    body {
        background-color: #1C1C1C; /* Dark background */
        color: #ECECEC; /* Text color */
    }

    .card {
        background-color: #2D2D2D; 
        border: none;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.2);
        border-radius: 8px;
    }

    .card-img-top {
        height: 200px;
        object-fit: cover; 
        border-top-left-radius: 8px;
        border-top-right-radius: 8px;
    }

    .btn-outline-primary {
        border-color: #6A936C; 
        color: #6A936C;
    }

    .btn-outline-primary:hover {
        background-color: #6A936C;
        color: #ECECEC;
    }
</style>
