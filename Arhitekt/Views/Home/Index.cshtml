@{
    ViewData["Title"] = "Home Page";
    var projects = ViewData["Projects"] as List<Arhitekt.Models.Project>;
}

<div class="hero">
    <div class="hero-content">
        <h1 style="color: #ECECEC; font-size: 3em; font-family: 'Cursive';">Welcome to Architect</h1>
        <p class="lead" style="color: #B0B0B0;">Find inspiration and connect with exceptional architects.</p>
    </div>
</div>



<div class="container mt-4">
    <div class="row">
        @if (projects != null && projects.Any())
        {
            foreach (var project in projects)
            {
                <div class="col-md-4 mb-4">
                    <div class="card">
                        <img src="@project.Image" class="card-img-top" alt="@project.Name" />
                        <div class="card-body">
                            <h5 class="card-title">@project.Name</h5>
                            <p class="card-text">@project.Description</p>
                            <a href="/Project/Details/@project.ProjectID" class="btn btn-outline-primary">View Project</a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <p class="text-center" style="color: #ECECEC;">No projects available at the moment.</p>
        }
    </div>
</div>

<style>
    body {
        background-color: #1C1C1C; /* Dark background */
        color: #ECECEC; /* Text color */
    }

    .card {
        background-color: #2D2D2D; 
        border: black;
        box-shadow: 0 6px 6px black;
        border-radius: 10px;
    }

    .card-img-top {
        height: 200px;
        object-fit: cover; 
        border-radius: 10px;
    }

    .btn-outline-primary {
        border-color: #49674a; 
        color: #49674a;
    }

    .btn-outline-primary:hover, .btn-outline-primary:focus {
        outline: none; 
        background-color: #49674a;
        color: #ECECEC;
        border-color: #49674a; 
        box-shadow: 0 0 10px rgba(106, 147, 108, 0.5); 
    }
    
    .hero {
        min-height: 230px;
        height: 20vh;
        align-items: center;
        justify-content: center; /* Poravnava na sredino */
        text-align: center; /* Poravnava na sredino */
        display: flex;
        padding: 50px; /* Dodaten razmik zgoraj in spodaj */
        background-color: #2D2D2D; /* Temno siva ozadje */
        color: #ECECEC; /* Svetla barva besedila */
        padding: 20px; /* Dodaten razmik zgoraj in spodaj */
        font-family: 'Cursive', sans-serif; /* Pisava za glavni naslov */
        border-radius: 10px;
    }
    
    .hero h1 {
        font-size: 3em; /* Velikost glavnega naslova */
        font-family: 'Cursive', sans-serif;;
        color: #ECECEC; /* Barva naslova */
        text-align: center; /* Poravnava na sredino */
        margin-bottom: 20px;
    }

    .hero p {
        font-size: 1.25em; /* Velikost podnaslova */
        font-family: 'Cursive', sans-serif;;
        text-align: center; /* Poravnava na sredino */
        color: #B0B0B0; /* Svetlo siva barva */
        margin-top: 10px; /* Dodaten razmik med naslovom in podnaslovom */
    }

</style>
