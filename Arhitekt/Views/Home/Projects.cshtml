@model IEnumerable<Arhitekt.Models.Project>

<div class="container">
    <div class="row">
        @if (Model.Any())
        {
            @foreach (var project in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card">
                        <img src="@project.Image" class="card-img-top" alt="@project.Name">
                        <div class="card-body">
                            <h5 class="card-title">@project.Name</h5>
                            <p class="card-text">@project.Description</p>
                            <a href="@Url.Action("Details", "Project", new { id = project.ProjectID })" class="btn btn-outline-primary">View Project</a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <p class="text-center">You have no projects. <a href="@Url.Action("Create", "Project")">Create one now!</a></p>
            </div>
        }
    </div>
</div>

<style>
    body {
        background-color: #1C1C1C;
        color: #ECECEC;
    }
    .card {
        background-color: #2D2D2D;
        border: none;
        border-radius: 8px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.2);
    }
    .card-img-top {
        border-top-left-radius: 8px;
        border-top-right-radius: 8px;
        height: 200px;
        object-fit: cover;
    }
    .btn-outline-primary {
        border-color: #6A936C;
        color: #6A936C;
    }
    .btn-outline-primary:hover {
        background-color: #6A936C;
        color: #ECECEC;
    }
</style>