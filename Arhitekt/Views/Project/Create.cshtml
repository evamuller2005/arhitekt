@model Arhitekt.Models.Project

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Project</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description" class="control-label"></label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DateCreated" class="control-label"></label>
                <input asp-for="DateCreated" class="form-control" />
                <span asp-validation-for="DateCreated" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label>Upload Image</label>
                <input type="file" id="file" name="file" class="form-control" />
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

<style>
    body {
        background-color: #1C1C1C; /* Dark background to match other pages */
        color: #ECECEC; /* Light text for contrast */
    }
    .card {
        background-color: #2D2D2D; /* Dark card background */
        border: none;
        border-radius: 8px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.2);
    }
    .card-header {
        background-color: #6A936C; /* Green accent consistent with other pages */
        color: #FFFFFF; /* White text for readability */
    }
    .btn-success {
        background-color: #6A936C; /* Green buttons to match the theme */
        border-color: #6A936C;
    }
    .btn-success:hover {
        background-color: #5A7E56; /* Darker green on hover */
        border-color: #4F7551;
    }
    .text-light {
        color: #ECECEC !important; /* Ensure all text with this class is light */
    }
    .img-fluid {
        max-height: 300px; /* Optional: Adjust image size as needed */
        object-fit: cover;
    }
</style>